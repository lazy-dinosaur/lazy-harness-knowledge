# Experiment result data is never committed (user-confirmed 2026-11-07).
.local/
.state/
runs/
results/
*.dump
*.log
__pycache__/
*.pyc
.pytest_cache/
node_modules/

# run state written by tests or runs must never be committed
packages/*/src/state/
packages/*/tests/state/
# stage-5 scratch source homes (removed after each record)
packages/core/src/stagewise-home-*/
